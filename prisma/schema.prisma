// LEED Togo — Database schema (Neon Postgres)
// Provider: postgresql (Neon serverless Postgres)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Enums  (#11 — replace free-string status fields)
// ──────────────────────────────────────────────

enum UserRole {
  user
  douyin
}

enum InvestmentStatus {
  active
  completed
}

enum ReferralStatus {
  pending
  paid
}

enum WithdrawalStatus {
  pending
  paid
  cancelled
}

enum PendingPaymentStatus {
  pending
  completed
  failed
}

// ──────────────────────────────────────────────
// User
// ──────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  phone        String   @unique          // 8-digit Togo number, no +228
  password     String                    // bcrypt hash
  name         String?                   // optional full name
  referralCode String   @unique          // LEED-XXXXXX
  referredBy   String?                  // referral code of sponsor
  role         UserRole @default(user)   // user | douyin
  suspended    Boolean  @default(false)  // true = account blocked by admin
  // Denormalised wallet balance (#9) — updated atomically inside transactions.
  // Formula: sum(investment.remb) + sum(completed investment.gain)
  //        + sum(paid referral.commission) - sum(paid|pending withdrawal.amount)
  balance      Int      @default(0)
  createdAt    DateTime @default(now())

  investments  Investment[]
  referrals    Referral[]   @relation("Referrer")
  withdrawals  Withdrawal[]
  adminLogs    AdminLog[]   @relation("AdminTarget")

  @@index([referralCode])
}

// ──────────────────────────────────────────────
// Investment — a plan subscription
// ──────────────────────────────────────────────
model Investment {
  id         String          @id @default(cuid())
  userId     String
  planName   String                    // Starter | Argent | Or | Premium
  amount     Int                       // deposit
  remb       Int                       // 50 % immediate refund
  gain       Int                       // total gain = amount × 3 (10 %/day × 30 days)
  status     InvestmentStatus @default(active)
  daysLeft   Int                       // approximate days remaining (for display)
  expiresAt  DateTime                  // exact expiry = createdAt + 30 days

  // 3-tranche payout timestamps (null = not yet paid)
  // Each tranche = amount (= gain / 3), paid at J+10, J+20, J+30
  tranche1PaidAt DateTime?             // J+10
  tranche2PaidAt DateTime?             // J+20
  tranche3PaidAt DateTime?             // J+30

  tchinToken String?                   // Tchin payment token (idempotence)
  createdAt  DateTime        @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tchinToken])
}

// ──────────────────────────────────────────────
// PendingPayment — Tchin token waiting for webhook
// ──────────────────────────────────────────────
model PendingPayment {
  id          String               @id @default(cuid())
  tchinToken  String               @unique          // Tchin payment token
  userId      String
  planId      String                                // starter | silver | gold | premium
  payMethod   String                                // flooz | tmoney
  phone       String                                // payment phone
  status      PendingPaymentStatus @default(pending)
  createdAt   DateTime             @default(now())

  @@index([userId])
}

// ──────────────────────────────────────────────
// Referral — someone signed up via the user's link
// ──────────────────────────────────────────────
model Referral {
  id            String         @id @default(cuid())
  referrerId    String
  referredPhone String                             // phone of the referred person
  planName      String?                            // plan they subscribed to (null = not yet)
  amount        Int?                               // amount invested (null = not yet)
  commission    Int            @default(500)       // fixed 500 FCFA
  status        ReferralStatus @default(pending)
  createdAt     DateTime       @default(now())

  referrer     User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  // Prevent double commission: one referral record per (sponsor, referred phone) pair.
  @@unique([referrerId, referredPhone])
  @@index([referrerId])
}

// ──────────────────────────────────────────────
// Withdrawal — money taken out of the wallet
// ──────────────────────────────────────────────
model Withdrawal {
  id        String           @id @default(cuid())
  userId    String
  amount    Int
  method    String                                // flooz | tmoney
  phone     String                                // withdrawal phone number
  status    WithdrawalStatus @default(pending)
  type      String                                // Remboursement 50% | Commission parrainage | Retrait manuel
  ref       String                                // human-readable ref, e.g. WD-005
  note      String?                               // optional admin note (max 500 chars)
  createdAt DateTime         @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────
// RevokedToken — JWT blacklist for real logout
// ──────────────────────────────────────────────
model RevokedToken {
  id        String   @id @default(cuid())
  token     String   @unique              // full JWT string (or its jti claim)
  expiresAt DateTime                      // same expiry as the JWT — for cleanup
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────
// AdminLog — audit trail for all admin actions
// ──────────────────────────────────────────────
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String                    // User.id of the admin who acted
  action     String                    // e.g. "withdrawal.paid", "user.suspend", "investment.complete"
  targetId   String?                   // id of the affected record
  targetType String?                   // "withdrawal" | "user" | "investment"
  meta       String?                   // JSON string for extra context (amount, phone, etc.)
  createdAt  DateTime @default(now())

  target     User?    @relation("AdminTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([createdAt])
}
