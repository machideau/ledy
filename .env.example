# ── Neon Postgres ──────────────────────────────
# Get your connection strings from the Neon Console:
#   Your project → Connect → copy both strings

# Pooled connection (has "-pooler" in hostname) — used by your app at runtime
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection — used by Prisma CLI (migrations, db push)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── JWT ────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-secret"

# ── Cron job ───────────────────────────────────
# Sécurise /api/cron/tick contre les appels non autorisés
CRON_SECRET="change-me-to-a-random-secret"

# ── Tchin (Mobile Money) ───────────────────────
# Get your keys from https://tchin.tech → espace → onglet API
PUBLIC_TCHIN_KEY="tchin_pk_..."
PRIVATE_TCHIN_KEY="tchin_sk_..."
# "test" | "live"
TCHIN_ENV="test"
# Full URL where Tchin sends payment confirmation webhooks
TCHIN_WEBHOOK_URL="https://yourdomain.com/api/tchin/webhook"
